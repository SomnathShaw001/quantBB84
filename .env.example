# BB84 Quantum Research Workbench & Server Configuration
# Copy this file to .env and adjust variables as needed.

# Application Server Port
# Locally defaults to 8000; on Zoho Catalyst AppSail, X_ZOHO_CATALYST_LISTEN_PORT is injected dynamically
PORT=8000
X_ZOHO_CATALYST_LISTEN_PORT=8000

# Server Runtime Environment
ENVIRONMENT=development
PYTHONUNBUFFERED=1

# SQLite Database Storage
# Local persistence for historical experiment logs, measurements, and PDF reports
DATABASE_PATH=simulations.db

# CORS Configuration
# Allow origins (use * for open laboratory access or specific origins in production)
CORS_ALLOW_ORIGINS=*

# Quantum Laboratory Defaults
DEFAULT_N_QUBITS=256
DEFAULT_QBER_THRESHOLD=0.11
DEFAULT_SAMPLE_FRACTION=0.25
